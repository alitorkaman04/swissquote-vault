# ZeroDev project (free): https://dashboard.zerodev.app -> create project on Base Sepolia -> copy Project ID
VITE_ZERODEV_PROJECT_ID=
# Mock Swissquote backend
VITE_BANK_API_URL=http://localhost:8787
# Recovery waiting period in seconds (demo). Production: 172800 (48h)
VITE_RECOVERY_DELAY_SECONDS=30
# Transfers above this (USDC) get the high-value step-up
VITE_HIGH_VALUE_THRESHOLD_USDC=1000
# Optional: pin the mock bank's guardian key (otherwise it is generated once and kept in server/data.json)
BANK_GUARDIAN_PRIVATE_KEY=
